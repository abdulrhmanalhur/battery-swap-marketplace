[Unit]
Description=BatterySwap owner-only MongoDB read MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/batteryswap-mongo-read
ExecStart=/opt/batteryswap-mongo-read/.venv/bin/python /opt/batteryswap-mongo-read/http_server.py
Environment=MONGODB_READ_ACTIVATED=1
Environment=FASTMCP_HOME=/var/lib/batteryswap-mongo-read/fastmcp
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=batteryswap-mongo-read
StateDirectoryMode=0700
LoadCredential=mongodb_uri:/etc/batteryswap-mongo-read/mongodb-uri
LoadCredential=github_client_id:/etc/batteryswap-mongo-read/github-client-id
LoadCredential=github_client_secret:/etc/batteryswap-mongo-read/github-client-secret
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=256M
TasksMax=64
Restart=on-failure
RestartSec=10
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
